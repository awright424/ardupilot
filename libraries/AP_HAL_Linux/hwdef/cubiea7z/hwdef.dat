# cubie a7z

# IMUs:
IMU Invensense SPI:icm42688 ROTATION_NONE
IMU Invensense SPI:icm45686 ROTATION_NONE
define INS_MAX_INSTANCES 3

# COMPASS QMC5883L I2C:1:0x0d true  ROTATION_NONE
define AP_COMPASS_PROBING_ENABLED 1

# Baros:
BARO BMP380 I2C:2:0x77

define HAL_BOARD_LOG_DIRECTORY "/home/alex/ardupilot/logs"
define HAL_BOARD_TERRAIN_DIRECTORY "/home/alex/ardupilot/terrain"
define HAL_BOARD_STORAGE_DIRECTORY "/home/alex/ardupilot"
define HAL_PARAM_DEFAULTS_PATH "/home/alex/ardupilot.parm"

#            NAME      BUS SUBDEV MODE       BPW CS_PIN         LOWSPD HIGHSPD
LINUX_SPIDEV "icm42688" 2   0      SPI_MODE_3 8   SPI_CS_KERNEL  1*MHZ  10*MHZ
LINUX_SPIDEV "icm45686" 2   1      SPI_MODE_3 8   SPI_CS_KERNEL  1*MHZ  10*MHZ

define APM_LINUX_RCIN_RATE 50

# I2C2 is the only i2c one exposed on a header
define HAL_LINUX_I2C_EXTERNAL_BUS_MASK 1 << 2

# We don't want any probing on the internal buses
define HAL_LINUX_I2C_INTERNAL_BUS_MASK 0


