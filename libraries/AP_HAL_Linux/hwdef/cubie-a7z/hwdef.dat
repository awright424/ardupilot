# Radxa Cubie A7Z (Allwinner A733 / sun60iw2) flight controller
#
# OUTPUTS
#   SERVO1..6 on header pins 35 (PB6), 37 (PM4), 38 (PB8), 40 (PB7),
#   33 (PM3), 32 (PM5), generated by the A733's E902 RISC-V core running
#   e902_dshot.bin. e902-dshot.service (e902ctl.py prepare) loads it before
#   ArduPilot starts; RCOutput_E902 passes the output values to it through a
#   shared-memory mailbox in the E902 SRAM (no GPIO access from Linux).
#
#   Output type follows MOT_PWM_TYPE (reboot ArduPilot after changing it):
#     4/5/6 DShot150/300/600 on SERVO1-6 (7 DShot1200 runs as DShot600)
#     0 Normal PWM, 8 PWMRange, 9 PWMAngle   SERVO1-4 only, per-output rate
#                                            (RC_SPEED / SERVO_RATE, max 480 Hz)
#     1 OneShot, 2 OneShot125                SERVO1-4 only, one pulse per loop
#     3 Brushed                              SERVO1-4 only, duty cycle at RC_SPEED
#   SERVO5-6 are DShot only: a hexacopter needs MOT_PWM_TYPE 4-6. One engine
#   drives all outputs: with DShot selected, outputs that are not DShot are
#   off; with a PWM type, SERVO5-6 are off.
#
# Buses kept free for the user's overlays:
#   SPI1 CS0  MCP2515 CAN controller  -> SocketCAN can0
#   SPI2      CS0 native, CS1/CS2 on PB4/PB5 as GPIO -> /dev/spidev2.0-2.2
#   I2C-2     header 27/28 (PD17/PD16)
#
# ASSUMED sensor layout (edit to match the actual carrier wiring):
#   spidev2.0 ICM-42688P, spidev2.1 ICM-45686, baro/compass on I2C-2.

env TOOLCHAIN aarch64-linux-gnu

# IMUs on SPI2
IMU Invensensev3 SPI:icm42688 ROTATION_NONE
IMU Invensensev3 SPI:icm45686 ROTATION_NONE

#              NAME         BUS SUBDEV MODE         BPW CS_PIN         LOWSPD HIGHSPD
LINUX_SPIDEV   "icm42688"   2   0      SPI_MODE_3   8   SPI_CS_KERNEL  1*MHZ  24*MHZ
LINUX_SPIDEV   "icm45686"   2   1      SPI_MODE_3   8   SPI_CS_KERNEL  1*MHZ  24*MHZ
# third SPI2 device, if one is fitted on CS2 (PB5), e.g. a BMP388:
# LINUX_SPIDEV "bmp388"     2   2      SPI_MODE_3   8   SPI_CS_KERNEL  1*MHZ  10*MHZ
# BARO BMP388 SPI:bmp388

# External sensors on I2C-2: probe it for compass and baro.
define HAL_LINUX_I2C_EXTERNAL_BUS_MASK (1 << 2)
define HAL_LINUX_I2C_INTERNAL_BUS_MASK 0
define AP_COMPASS_PROBING_ENABLED 1
# BARO_PROBE_EXT default: BMP280, DPS280/310, BMP388/390, SPL06, BMP581
define HAL_BARO_PROBE_EXT_DEFAULT 11330

# CAN: MCP2515 on SPI1 via the kernel mcp251x driver (SocketCAN can0)
env WITH_CAN 1
define HAL_NUM_CAN_IFACES 1

# Directories
define HAL_BOARD_LOG_DIRECTORY     "/var/lib/ardupilot/logs"
define HAL_BOARD_TERRAIN_DIRECTORY "/var/lib/ardupilot/terrain"
define HAL_BOARD_STORAGE_DIRECTORY "/var/lib/ardupilot"
define HAL_PARAM_DEFAULTS_PATH     "/etc/ardupilot/defaults.parm"
define SCRIPTING_DIRECTORY         "/var/lib/ardupilot/scripts"

define CONFIG_HAL_BOARD_SUBTYPE HAL_BOARD_SUBTYPE_LINUX_CUBIE_A7Z
